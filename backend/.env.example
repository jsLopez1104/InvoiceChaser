# Copia este archivo como .env y llena los valores. NUNCA subas el .env al repo.
ENVIRONMENT=development
DEMO_MODE=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# SQLite para desarrollo; en producción PostgreSQL:
# DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoicechaser
DATABASE_URL=sqlite:///./invoicechaser.db

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Resend (https://resend.com). Vacío = los correos se imprimen en consola.
RESEND_API_KEY=
EMAIL_FROM=InvoiceChaser <onboarding@resend.dev>

# Wompi sandbox (https://comercios.wompi.co). Vacío = simulador de pagos en modo demo.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Recordatorios
REMINDER_OFFSETS=-3,0,7,14,21
MIN_DAYS_BETWEEN_OVERDUE=7
